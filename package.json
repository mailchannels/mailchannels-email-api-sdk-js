{
  "name": "mailchannels-sdk",
  "version": "1.4.0",
  "description": "Node.js SDK to integrate MailChannels Email API into your JavaScript or TypeScript server-side applications.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mailchannels",
    "typescript",
    "email",
    "transactional-email",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/mailchannels/mailchannels-email-api-sdk-js.git"
  },
  "homepage": "https://mailchannels.yizack.com",
  "author": {
    "name": "MailChannels",
    "email": "dev@mailchannels.com"
  },
  "main": "./dist/mailchannels.mjs",
  "exports": {
    ".": {
      "types": "./dist/mailchannels.d.mts",
      "default": "./dist/mailchannels.mjs"
    },
    "./simulator": {
      "types": "./dist/simulator/index.d.mts",
      "default": "./dist/simulator/index.mjs"
    },
    "./nodemailer": {
      "types": "./dist/plugins/nodemailer/index.d.mts",
      "default": "./dist/plugins/nodemailer/index.mjs"
    }
  },
  "types": "./dist/mailchannels.d.mts",
  "bin": {
    "mailchannels-sdk": "./dist/cli/index.mjs",
    "mailchannels": "./dist/cli/index.mjs"
  },
  "files": [
    "dist",
    ".agents/skills/mailchannels-js"
  ],
  "scripts": {
    "build": "obuild",
    "parity:fixtures": "node scripts/generate-parity-fixtures.ts",
    "prepack": "pnpm build",
    "release": "pnpm lint && pnpm test && pnpm build && changelogen --bump",
    "cli": "pnpx jiti src/cli/index.ts",
    "simulate": "pnpx jiti src/cli/index.ts simulate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --reporter=verbose --coverage",
    "test:types": "tsc --noEmit",
    "test:watch": "vitest watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "(git fetch --unshallow -q || git fetch --all -q) && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:snippets": "node docs/scripts/snippets.ts"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "mime": "^4.1.0",
    "ofetch": "^2.0.0-alpha.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "changelogen": "^0.6.2",
    "nodemailer": "^9.0.5",
    "obuild": "^0.4.38",
    "oxlint": "^1.78.0",
    "scule": "^1.3.0",
    "typescript": "^6.0.3",
    "vitepress": "^2.0.0-alpha.19",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vitepress-plugin-llms": "^1.13.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0"
}
